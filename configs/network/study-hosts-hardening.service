[Unit]
Description=Enforce Distraction-Free Study Hosts & Policy Hardening
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target multi-user.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c "chmod 444 /etc/hosts && chattr +i /etc/hosts 2>/dev/null || true; /usr/local/sbin/apply-hosts-hardening.sh"
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
